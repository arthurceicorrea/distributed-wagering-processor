{
  "name": "distributed-wagering-processor",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "bun": ">=1.2"
  },
  "scripts": {
    "start": "bun run src/main.ts",
    "start:dev": "bun --watch run src/main.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "migration:up": "bun x mikro-orm migration:up --config src/infrastructure/config/mikro-orm.config.ts",
    "migration:down": "bun x mikro-orm migration:down --config src/infrastructure/config/mikro-orm.config.ts",
    "test": "bun test test/unit.spec.ts",
    "test:integration": "bun test test/integration.spec.ts",
    "test:concurrency": "bun test test/concurrency.spec.ts",
    "test:all": "bun test test/unit.spec.ts test/integration.spec.ts test/concurrency.spec.ts",
    "test:load": "bun run test/load.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.750.0",
    "@mikro-orm/core": "^6.4.8",
    "@mikro-orm/migrations": "^6.4.8",
    "@mikro-orm/nestjs": "^6.1.1",
    "@mikro-orm/postgresql": "^6.4.8",
    "@nestjs/common": "^10.4.22",
    "@nestjs/core": "^10.4.22",
    "@nestjs/platform-express": "^10.4.22",
    "decimal.js": "^10.5.0",
    "jose": "^5.9.6",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@mikro-orm/cli": "^6.4.8",
    "@nestjs/testing": "^10.4.22",
    "@types/bun": "latest",
    "@types/express": "^4.17.21",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
